    errorEl.textContent = 'Please enter both birth date and time to generate your reading.';
    errorEl.style.display = 'block';
    return;
  }

  const [y, m, d] = dateStr.split('-').map(Number);
  const [hh, mm] = timeStr.split(':').map(Number);
  const birth = new Date(y, m - 1, d, hh, mm);

  // Hide form, show loading
  document.getElementById('input-card').style.display = 'none';
  document.getElementById('loading').classList.add('visible');
  document.getElementById('loading').scrollIntoView({ behavior: 'smooth', block: 'start' });

  // Loading sequence with messages
  const messages = [
    'Computing solar terms',
    'Reading the four pillars',
    'Mapping element balance',
    'Identifying Day Master'
  ];
  let msgIdx = 0;
  const msgInterval = setInterval(() => {
    msgIdx = (msgIdx + 1) % messages.length;
