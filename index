function getCurrentForecast(chart) {
  const today = new Date();
  const todayDay = getDayPillar(today);
  const todayStem = STEMS[todayDay.stemIdx];
  const myStem = STEMS[chart.pillars.day.stemIdx];
  const els = ['Wood','Fire','Earth','Metal','Water'];
  const mi = els.indexOf(myStem.element), oi = els.indexOf(todayStem.element);
  let energyLevel, theme;
  if (mi === oi) { energyLevel = 85; theme = 'high alignment — what you start lands'; }
  else if ((mi + 4) % 5 === oi) { energyLevel = 90; theme = 'supported and replenished — receive'; }
  else if ((mi + 1) % 5 === oi) { energyLevel = 70; theme = 'creative output is favored — make and share'; }
  else if ((mi + 2) % 5 === oi) { energyLevel = 65; theme = 'wealth and structure activated — direct your resources'; }
  else { energyLevel = 45; theme = 'pressure and discipline showing up — rest matters'; }
  return { todayStem, energyLevel, theme };
}

