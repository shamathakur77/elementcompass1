    }, 100);
  }, 2400);
});

function animateCalligraphy(chart) {
  const dayStem = STEMS[chart.pillars.day.stemIdx];
  const svg = document.querySelector('.signature-mark-svg');
  if (!svg) return;
  setTimeout(() => {
    svg.classList.add('animating');
    if (soundOn) {
      const strokes = STROKE_PATHS[dayStem.name] || [];
      strokes.forEach((_, i) => {
        setTimeout(playBrushSound, 200 + i * 1000);
      });
    }
  }, 400);
}

function animateEnergyMeter() {
  const fill = document.querySelector('.energy-meter-fill');
  if (fill) {
    const target = fill.getAttribute('data-target');
    fill.style.width = target + '%';
  }
}

function initRevealObserver() {
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
}

