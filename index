<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Element Compass · Ancient Wisdom for Modern Souls</title>
<meta name="description" content="Discover your Day Master through 1,200-year-old Chinese metaphysics. A Bazi reader written for people who didn't grow up with it.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Mono:wght@300;400;500&family=Noto+Serif+SC:wght@400;500;600;700;900&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
  :root {
    --ink: #0d0c0a;
    --ink-soft: #2a2620;
    --paper: #f5f0e8;
    --paper-warm: #ede4d3;
    --paper-deep: #e4d8c0;
    --gold: #c9a84c;
    --gold-soft: #d9bd6a;
    --gold-deep: #a8893a;
    --rust: #b85c38;
    --teal: #3a7d74;
    --muted: #5a5246;
    --line: rgba(13,12,10,0.12);
    --line-strong: rgba(13,12,10,0.25);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    background: var(--paper);
    color: var(--ink);
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 18px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body {
    background-image:
      radial-gradient(ellipse at 20% 10%, rgba(201,168,76,0.07) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 80%, rgba(184,92,56,0.04) 0%, transparent 50%);
    position: relative;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='3'/%3E%3CfeColorMatrix values='0 0 0 0 0.05 0 0 0 0 0.05 0 0 0 0 0.04 0 0 0 0.4 0'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.4;
    pointer-events: none;
    z-index: 1;
  }

  /* Corner ornaments */
  .corner-ornament {
    position: fixed;
    width: 70px;
    height: 70px;
    border: 1px solid var(--gold);
    opacity: 0.4;
    pointer-events: none;
    z-index: 5;
  }
  .corner-ornament.tl { top: 20px; left: 20px; border-right: none; border-bottom: none; }
  .corner-ornament.tr { top: 20px; right: 20px; border-left: none; border-bottom: none; }
  .corner-ornament.bl { bottom: 20px; left: 20px; border-right: none; border-top: none; }
  .corner-ornament.br { bottom: 20px; right: 20px; border-left: none; border-top: none; }

  /* Sound toggle - floating, top right */
  .sound-toggle {
    position: fixed;
    top: 32px;
    right: 100px;
    width: 44px;
    height: 44px;
    background: var(--paper-warm);
    border: 1px solid var(--gold);
    border-radius: 50%;
    cursor: pointer;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    color: var(--gold-deep);
  }
  .sound-toggle:hover {
    background: var(--gold);
    color: var(--ink);
    transform: scale(1.05);
  }
  .sound-toggle.on {
    background: var(--ink);
    color: var(--gold);
    border-color: var(--gold);
  }
  .sound-toggle svg { width: 18px; height: 18px; }

  .container {
    max-width: 920px;
    margin: 0 auto;
    padding: 80px 24px 80px;
    position: relative;
    z-index: 3;
  }

  /* === HEADER === */
  .header {
    text-align: center;
    margin-bottom: 56px;
    opacity: 0;
    transform: translateY(20px);
    animation: rise 1.2s ease forwards;
  }

  @keyframes rise {
    to { opacity: 1; transform: translateY(0); }
  }

  .badge {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-deep);
    padding: 6px 14px;
    border: 1px solid var(--gold);
    margin-bottom: 24px;
    background: rgba(201,168,76,0.05);
  }

  .chinese-mark {
    font-family: 'Noto Serif SC', serif;
    font-size: 56px;
    font-weight: 700;
    color: var(--gold);
    line-height: 1;
    letter-spacing: 12px;
    margin-bottom: 16px;
    display: inline-block;
    padding: 0 12px;
    text-shadow: 0 0 30px rgba(201,168,76,0.15);
  }

  h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 56px;
    font-weight: 300;
    color: var(--ink);
    letter-spacing: 1px;
    line-height: 1.1;
    margin-bottom: 12px;
  }
  h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--gold-deep);
  }

  .subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 22px;
    color: var(--muted);
    margin-bottom: 24px;
  }

  .ornament-line {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin: 24px 0;
  }
  .ornament-line::before,
  .ornament-line::after {
    content: "";
    width: 80px;
    height: 1px;
    background: var(--gold);
  }
  .ornament-line span {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--gold-deep);
    text-transform: uppercase;
  }

  /* === FORM CARD === */
  .card {
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper-deep) 100%);
    border: 1px solid var(--line);
    padding: 40px 36px;
    margin-bottom: 32px;
    position: relative;
  }
  .card::before {
    content: "";
    position: absolute;
    top: 10px; left: 10px; right: 10px; bottom: 10px;
    border: 1px solid var(--gold);
    opacity: 0.3;
    pointer-events: none;
  }

  .section-tag {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--gold-deep);
    margin-bottom: 16px;
    text-align: center;
  }

  .card h2 {
    text-align: center;
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 400;
    margin-bottom: 28px;
  }

  .input-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 18px;
  }
  @media (min-width: 640px) {
    .input-grid { grid-template-columns: 1fr 1fr; }
    .input-grid .full { grid-column: 1 / -1; }
  }

  .field label {
    display: block;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--ink);
    margin-bottom: 6px;
    font-weight: 500;
  }
  .field input, .field select {
    width: 100%;
    padding: 14px 16px;
    background: var(--paper);
    border: 1px solid var(--line-strong);
    border-radius: 0;
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    color: var(--ink);
    transition: all 0.2s ease;
  }
  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--gold);
    box-shadow: 0 0 0 3px rgba(201,168,76,0.1);
  }
  .field .hint {
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    color: var(--muted);
    margin-top: 4px;
    letter-spacing: 1px;
  }

  /* Area selector */
  .area-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 8px;
  }
  @media (min-width: 640px) {
    .area-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .area-option {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 16px 12px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .area-option:hover { border-color: var(--gold); }
  .area-option.selected {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }
  .area-symbol {
    font-family: 'Noto Serif SC', serif;
    font-size: 24px;
    color: var(--gold);
    margin-bottom: 6px;
    line-height: 1;
  }
  .area-option.selected .area-symbol { color: var(--gold-soft); }
  .area-label {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 15px;
  }

  /* Big primary button */
  .btn {
    display: block;
    width: 100%;
    margin-top: 32px;
    padding: 18px;
    background: var(--ink);
    color: var(--paper);
    border: none;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .btn::before {
    content: "";
    position: absolute;
    top: 50%; left: 50%;
    width: 0; height: 0;
    background: var(--gold);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: width 0.6s ease, height 0.6s ease;
    z-index: 0;
  }
  .btn:hover::before { width: 600px; height: 600px; }
  .btn span { position: relative; z-index: 1; }
  .btn:hover { color: var(--ink); }

  /* === LOADING SEQUENCE === */
  .loading {
    display: none;
    text-align: center;
    padding: 80px 20px;
    animation: fadeIn 0.5s ease;
  }
  .loading.visible { display: block; }

  @keyframes fadeIn { from {opacity:0} to {opacity:1} }

  .loading-mark {
    font-family: 'Noto Serif SC', serif;
    font-size: 80px;
    color: var(--gold);
    line-height: 1;
    animation: breathe 2s ease infinite;
    margin-bottom: 24px;
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.4; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .loading-text {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 24px;
    color: var(--muted);
    margin-bottom: 12px;
  }

  .loading-detail {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--gold-deep);
    text-transform: uppercase;
  }

  /* === READING === */
  .reading {
    display: none;
  }
  .reading.visible { display: block; }

  /* Scroll reveal */
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s ease, transform 1s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* === SOUL SIGNATURE CARD (the hero) === */
  .signature {
    background: linear-gradient(180deg, var(--ink) 0%, #1a1815 100%);
    color: var(--paper);
    border: 1px solid var(--gold);
    padding: 60px 36px;
    margin-bottom: 32px;
    position: relative;
    text-align: center;
    overflow: hidden;
  }
  .signature::before {
    content: "";
    position: absolute;
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    border: 1px solid rgba(201,168,76,0.3);
    pointer-events: none;
  }
  .signature::after {
    content: "";
    position: absolute;
    top: -50%; left: -50%;
    width: 200%; height: 200%;
    background: radial-gradient(circle, rgba(201,168,76,0.15) 0%, transparent 40%);
    pointer-events: none;
    animation: pulse-glow 8s ease infinite;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.5; }
    50% { opacity: 1; }
  }

  .signature-tag {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 24px;
    position: relative;
    z-index: 2;
  }

  /* The animated calligraphy mark */
  .signature-mark-wrap {
    width: 200px;
    height: 200px;
    margin: 16px auto;
    position: relative;
    z-index: 2;
  }
  .signature-mark-svg {
    width: 100%;
    height: 100%;
  }
  .signature-mark-svg .stroke {
    fill: none;
    stroke: var(--gold);
    stroke-width: 14;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 12px rgba(201,168,76,0.4));
  }
  .signature-mark-svg.animating .stroke {
    stroke-dasharray: 1000;
    stroke-dashoffset: 1000;
    animation: drawStroke 1.4s ease forwards;
  }
  .signature-mark-svg.animating .stroke-1 { animation-delay: 0.2s; }
  .signature-mark-svg.animating .stroke-2 { animation-delay: 1.4s; }
  .signature-mark-svg.animating .stroke-3 { animation-delay: 2.4s; }
  .signature-mark-svg.animating .stroke-4 { animation-delay: 3.4s; }
  .signature-mark-svg.animating .stroke-5 { animation-delay: 4.0s; }

  @keyframes drawStroke {
    to { stroke-dashoffset: 0; }
  }

  .signature-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-style: italic;
    font-weight: 400;
    color: var(--paper);
    margin-top: 24px;
    margin-bottom: 6px;
    position: relative;
    z-index: 2;
  }

  .signature-archetype {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 500;
    color: var(--gold);
    letter-spacing: 1px;
    margin-bottom: 6px;
    position: relative;
    z-index: 2;
  }

  .signature-element {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 4px;
    color: var(--gold-soft);
    text-transform: uppercase;
    margin-bottom: 24px;
    position: relative;
    z-index: 2;
  }

  .signature-tagline {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 20px;
    color: var(--paper-warm);
    max-width: 480px;
    margin: 0 auto 24px;
    line-height: 1.6;
    position: relative;
    z-index: 2;
  }

  .signature-actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 16px;
    position: relative;
    z-index: 2;
    flex-wrap: wrap;
  }

  .share-btn {
    background: transparent;
    color: var(--gold);
    border: 1px solid var(--gold);
    padding: 12px 22px;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .share-btn:hover {
    background: var(--gold);
    color: var(--ink);
  }
  .share-btn svg { width: 14px; height: 14px; }

  /* === INSIGHT CARDS === */
  .insight-card {
    background: var(--paper-warm);
    border: 1px solid var(--line);
    padding: 36px;
    margin-bottom: 24px;
    position: relative;
  }
  .insight-card::before {
    content: "";
    position: absolute;
    top: 10px; left: 10px; right: 10px; bottom: 10px;
    border: 1px solid var(--gold);
    opacity: 0.25;
    pointer-events: none;
  }
  .insight-number {
    position: absolute;
    top: -16px;
    left: 32px;
    background: var(--paper);
    padding: 0 12px;
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    color: var(--gold-deep);
    z-index: 2;
  }
  .insight-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-style: italic;
    font-weight: 500;
    margin-bottom: 16px;
    line-height: 1.2;
    color: var(--ink);
  }
  .insight-card p {
    font-size: 17px;
    margin-bottom: 12px;
    color: var(--ink);
    line-height: 1.7;
  }
  .insight-card p strong { font-weight: 600; }
  .insight-card p em { color: var(--ink-soft); }

  /* === COMPASS === */
  .compass-section {
    margin: 28px 0;
    padding: 24px;
    background: var(--paper);
    border: 1px solid var(--line);
  }
  .compass-label {
    text-align: center;
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--gold-deep);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .compass-wrap {
    position: relative;
    width: 100%;
    max-width: 360px;
    margin: 0 auto;
    aspect-ratio: 1;
  }
  .compass-svg { width: 100%; height: 100%; }
  .compass-svg .ring { animation: rotate-slow 60s linear infinite; transform-origin: 160px 160px; }
  @keyframes rotate-slow { to { transform: rotate(360deg); } }

  .compass-svg .axis {
    opacity: 0;
    animation: fadeInAxis 1.5s ease forwards;
  }
  .compass-svg .axis-0 { animation-delay: 0.2s; }
  .compass-svg .axis-1 { animation-delay: 0.5s; }
  .compass-svg .axis-2 { animation-delay: 0.8s; }
  .compass-svg .axis-3 { animation-delay: 1.1s; }
  .compass-svg .axis-4 { animation-delay: 1.4s; }

  @keyframes fadeInAxis { to { opacity: 1; } }

  .compass-svg .you-dot {
    animation: pulse-dot 2s ease infinite;
    transform-origin: center;
    transform-box: fill-box;
  }
  @keyframes pulse-dot {
    0%, 100% { opacity: 1; r: 8; }
    50% { opacity: 0.8; r: 10; }
  }

  /* === FORECAST === */
  .forecast {
    background: var(--ink);
    color: var(--paper);
    padding: 40px 36px;
    margin-bottom: 24px;
    position: relative;
    border: 1px solid var(--gold);
  }
  .forecast::before {
    content: "";
    position: absolute;
    top: 10px; left: 10px; right: 10px; bottom: 10px;
    border: 1px solid rgba(201,168,76,0.3);
    pointer-events: none;
  }
  .forecast-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-soft);
    margin-bottom: 12px;
  }
  .forecast h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px;
    font-weight: 400;
    font-style: italic;
    color: var(--paper);
    margin-bottom: 16px;
    line-height: 1.2;
  }
  .forecast p {
    color: var(--paper-warm);
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 12px;
  }
  .energy-meter {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 20px 0;
    padding: 16px 0;
    border-top: 1px solid rgba(201,168,76,0.2);
    border-bottom: 1px solid rgba(201,168,76,0.2);
  }
  .energy-meter-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--gold-soft);
    text-transform: uppercase;
    flex: 0 0 80px;
  }
  .energy-meter-bar {
    flex: 1;
    height: 4px;
    background: rgba(255,255,255,0.1);
    position: relative;
  }
  .energy-meter-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--gold-deep), var(--gold));
    width: 0;
    transition: width 1.5s ease;
    box-shadow: 0 0 12px rgba(201,168,76,0.4);
  }
  .energy-meter-value {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 18px;
    color: var(--gold);
    flex: 0 0 60px;
    text-align: right;
  }

  /* === RHYTHMS === */
  .rhythm-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin: 24px 0;
  }
  @media (min-width: 640px) {
    .rhythm-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .rhythm-item {
    background: var(--paper);
    border: 1px solid var(--line);
    padding: 20px 18px;
    position: relative;
  }
  .rhythm-time {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 2px;
    color: var(--gold-deep);
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .rhythm-title {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 19px;
    margin-bottom: 6px;
    color: var(--ink);
  }
  .rhythm-text {
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink);
  }

  /* === PAYWALL === */
  .paywall {
    background: linear-gradient(180deg, var(--paper-warm) 0%, var(--paper-deep) 100%);
    padding: 56px 36px;
    margin: 40px 0;
    text-align: center;
    position: relative;
    border: 1px solid var(--gold);
  }
  .paywall::before {
    content: "";
    position: absolute;
    top: 14px; left: 14px; right: 14px; bottom: 14px;
    border: 1px solid var(--gold);
    opacity: 0.3;
    pointer-events: none;
  }
  .paywall-badge {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 9px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--gold-deep);
    padding: 5px 14px;
    border: 1px solid var(--gold);
    background: var(--paper);
    margin-bottom: 16px;
  }
  .paywall h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 38px;
    font-style: italic;
    font-weight: 400;
