// ============================================================
// AMBIENT SOUND - Tibetan singing bowl drone via Web Audio API
// ============================================================
let audioCtx = null;
let soundOn = false;
let soundNodes = [];

function initAudio() {
  if (audioCtx) return;
  audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

function startBowl() {
  initAudio();
  if (audioCtx.state === 'suspended') audioCtx.resume();

  // Multiple oscillators tuned to a low Tibetan bowl harmonic series (F2 fundamental ~87Hz)
  const fundamental = 87.31;
  const harmonics = [1, 2.61, 4.83, 7.39]; // Bowl-like inharmonic ratios
  const gains = [0.06, 0.04, 0.025, 0.015];

  const masterGain = audioCtx.createGain();
  masterGain.gain.setValueAtTime(0, audioCtx.currentTime);
  masterGain.gain.linearRampToValueAtTime(1, audioCtx.currentTime + 3); // Slow fade in

  // Reverb-ish via convolver with synthesized impulse
  const convolver = audioCtx.createConvolver();
  const impulseLen = audioCtx.sampleRate * 4;
  const impulse = audioCtx.createBuffer(2, impulseLen, audioCtx.sampleRate);
  for (let ch = 0; ch < 2; ch++) {
    const data = impulse.getChannelData(ch);
    for (let i = 0; i < impulseLen; i++) {
      data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / impulseLen, 2);
    }
  }
  convolver.buffer = impulse;

  // Create oscillators
  harmonics.forEach((mult, idx) => {
    const osc = audioCtx.createOscillator();
    osc.type = 'sine';
    osc.frequency.value = fundamental * mult;

    // Slow LFO for shimmer
    const lfo = audioCtx.createOscillator();
    const lfoGain = audioCtx.createGain();
    lfo.frequency.value = 0.1 + idx * 0.07;
    lfoGain.gain.value = mult * 0.3;
    lfo.connect(lfoGain);
    lfoGain.connect(osc.frequency);
    lfo.start();

    const oscGain = audioCtx.createGain();
    oscGain.gain.value = gains[idx];

    osc.connect(oscGain);
    oscGain.connect(masterGain);
    osc.start();

    soundNodes.push(osc, lfo, oscGain, lfoGain);
  });

  masterGain.connect(convolver);
  convolver.connect(audioCtx.destination);

  // Also direct (drier) signal
  const dryGain = audioCtx.createGain();
  dryGain.gain.value = 0.5;
  masterGain.connect(dryGain);
  dryGain.connect(audioCtx.destination);

  soundNodes.push(masterGain, convolver, dryGain);
}

function stopBowl() {
  if (!audioCtx) return;
  soundNodes.forEach(n => {
    try {
      if (n.stop) n.stop();
      n.disconnect();
    } catch(e) {}
  });
  soundNodes = [];
}

// Single ink-brush stroke sound when calligraphy draws
function playBrushSound() {
  if (!soundOn || !audioCtx) return;
  const dur = 0.4;
  const now = audioCtx.currentTime;

  // Noise burst with bandpass for "shhhh" of brush
  const bufferSize = audioCtx.sampleRate * dur;
  const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < bufferSize; i++) {
    data[i] = (Math.random() * 2 - 1) * (1 - i / bufferSize);
  }
  const noise = audioCtx.createBufferSource();
  noise.buffer = buffer;

  const bp = audioCtx.createBiquadFilter();
  bp.type = 'bandpass';
  bp.frequency.value = 2000;
  bp.Q.value = 1.5;

  const g = audioCtx.createGain();
  g.gain.setValueAtTime(0.15, now);
  g.gain.exponentialRampToValueAtTime(0.001, now + dur);

  noise.connect(bp);
  bp.connect(g);
  g.connect(audioCtx.destination);
  noise.start(now);
}

document.getElementById('sound-toggle').addEventListener('click', function() {
  soundOn = !soundOn;
  this.classList.toggle('on', soundOn);
  if (soundOn) {
    startBowl();
